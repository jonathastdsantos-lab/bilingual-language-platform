# =============================================================================
# SONDAPRO / ODONTO GESTÃO — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# =============================================================================
# Copie este arquivo para `.env` e preencha com as credenciais públicas do seu
# projeto Supabase. NUNCA exponha a chave `service_role` ou senhas do banco no
# frontend (variáveis prefixadas com VITE_).

# ID do projeto no Supabase
SUPABASE_PROJECT_ID="seu_project_id_aqui"
VITE_SUPABASE_PROJECT_ID="seu_project_id_aqui"

# URL pública da API do Supabase
SUPABASE_URL="https://seu_project_id_aqui.supabase.co"
VITE_SUPABASE_URL="https://seu_project_id_aqui.supabase.co"

# Chave pública (Publishable / Anon Key) — segura para uso no cliente com RLS ativo
SUPABASE_PUBLISHABLE_KEY="sb_publishable_sua_chave_publica_aqui"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_sua_chave_publica_aqui"

# Opcional: URL de conexão direta apenas para execução de migrations via CLI/Drizzle
# LOVABLE_DB_MIGRATION_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres"

